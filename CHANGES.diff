+def record_login(user_id):
+    """Stamp the current time as this user's most recent successful login."""
+    conn = get_conn()
+    conn.execute("UPDATE users SET last_login = ? WHERE id = ?", (now_iso(), user_id))
+    conn.commit()
+    conn.close()
